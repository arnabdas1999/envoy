# ─── Database ─────────────────────────────────────────────────────────────────
# Vercel Postgres (Neon) connection string — add via Vercel dashboard
POSTGRES_URL=postgres://user:password@host/envoy?sslmode=require

# ─── App URL ──────────────────────────────────────────────────────────────────
# Used for server-side fetch calls and magic link URLs.
# In production set this to your Vercel deployment URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_64_random_hex_bytes

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Get a free API key at https://resend.com
# A value starting with re_test_ logs the link to console instead of sending.
RESEND_API_KEY=re_test_placeholder
RESEND_FROM=auth@useenvoy.dev

# ─── Optional: Upstash Redis for distributed rate limiting ────────────────────
# Falls back to per-instance in-memory limiting if not set (fine for dev).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
