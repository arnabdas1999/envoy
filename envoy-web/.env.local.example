# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase pooler URL (Transaction mode, port 6543) — required for Vercel serverless
POSTGRES_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# ─── App URL ──────────────────────────────────────────────────────────────────
# Used for server-side fetch calls and magic link URLs.
# In production set this to your Vercel deployment URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_64_random_hex_bytes

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Get a free API key at https://resend.com
# A value starting with re_test_ logs the link to console instead of sending.
RESEND_API_KEY=re_test_placeholder
RESEND_FROM=onboarding@resend.dev

# ─── Upstash Redis (required) ─────────────────────────────────────────────────
# Create a free database at https://upstash.com
# Used for: distributed rate limiting + magic link token storage
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here
